<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VideoKompressor.App"
             RequestedThemeVariant="Light">
             
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

             
    <Application.Styles>

        <FluentTheme />

        <!-- Set the Global window background -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#f9f9f9"/>
        </Style>

        <!-- Normal state -->
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#d4d4d4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Hover -->
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e0eef9"/>
            <Setter Property="BorderBrush" Value="#0078d4"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- Pressed (while mouse button is down) -->
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#b6d8f1"/>
            <Setter Property="BorderBrush" Value="#004070"/>
        </Style>

        <!-- Animations for Buttons when hovered -->
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

    </Application.Styles>
</Application>